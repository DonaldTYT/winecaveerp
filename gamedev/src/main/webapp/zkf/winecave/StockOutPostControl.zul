<zk>
	<window title="StockOut Posting Control" border="normal" width="720px" closable="true">
		<vlayout sclass="zkbi-form-content" spacing="12px">
			<label value="Select an operation" sclass="zkbi-form-header" />
			<radiogroup id="stockOutOperation">
				<hlayout spacing="18px">
					<radio id="opPost" label="Post" value="post" checked="true" />
					<radio id="opUnpost" label="UnPost" value="unpost" />
					<radio id="opConfirmPo" label="Confirm PO" value="confirm_po" />
					<radio id="opUnconfirmPo" label="Unconfirm PO" value="unconfirm_po" />
				</hlayout>
			</radiogroup>
			<label value="For Confirm PO or Unconfirm PO, select one or more consignees:" />
			<listbox id="consigneeList" width="100%" height="300px" multiple="true" checkmark="true">
				<listhead sizable="true">
					<listheader label="Consignee" width="140px" />
					<listheader label="PO Number" width="190px" />
					<listheader label="Amount" width="130px" align="right" />
					<listheader label="Status" />
				</listhead>
			</listbox>
			<div align="center" width="100%">
				<hlayout spacing="10px">
					<button id="btProceed" label="Proceed" width="100px" />
					<button id="btCancel" label="Cancel" width="100px" />
				</hlayout>
			</div>
		</vlayout>
	</window>
</zk>
